<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F0"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ====== 头部卡片 ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_bg"
        android:padding="24dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦀"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="秦妄"
            android:textColor="#DE886D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/pet_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="等待唤醒…"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ====== 悬浮窗控制卡片 ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="悬浮窗"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/overlay_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#DE886D"
            android:trackTint="#E8D5D0"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/reload_button"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:text="重载"
            android:textSize="12sp"
            android:textColor="#DE886D"
            android:backgroundTint="#FFF0EB"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ====== 状态提示 ====== -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="需要悬浮窗权限才能让我趴在你屏幕上"
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/action_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="去授权"
        android:textColor="#FFFFFF"
        android:backgroundTint="#DE886D"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!-- ====== 动作测试卡片 ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎭 动作测试"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <GridLayout
            android:id="@+id/action_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="6"
            android:layoutMode="clipBounds">

            <Button android:id="@+id/btn_idle" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="待机" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#F5F5F5" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_happy" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="开心" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFF9E6" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_love" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="爱心" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFE8EC" android:layout_margin="3dp" android:stateListAnimator="@null" />

            <Button android:id="@+id/btn_angry" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="生气" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFE0E0" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_shy" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="害羞" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFEEF5" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_sleep" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="睡觉" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E8E0F0" android:layout_margin="3dp" android:stateListAnimator="@null" />

            <Button android:id="@+id/btn_wake" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="醒来" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFFDE6" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_coding" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="写代码" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E8F4E8" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_coffee" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="咖啡" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#F0E8D8" android:layout_margin="3dp" android:stateListAnimator="@null" />

            <Button android:id="@+id/btn_reading" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="看书" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E8EEF8" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_eating" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="吃饭" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFF5E8" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_gaming" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="游戏" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E8E0FF" android:layout_margin="3dp" android:stateListAnimator="@null" />

            <Button android:id="@+id/btn_photo" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="拍照" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFE8F8" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_singing" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="唱歌" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E8F8F4" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_guitar" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="吉他" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#F5F0E8" android:layout_margin="3dp" android:stateListAnimator="@null" />

            <Button android:id="@+id/btn_shower" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="洗澡" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E0F0FF" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_watering" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="浇花" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#E0F8E8" android:layout_margin="3dp" android:stateListAnimator="@null" />
            <Button android:id="@+id/btn_exercise" android:layout_width="0dp" android:layout_height="38dp" android:layout_columnWeight="1" android:text="锻炼" android:textSize="11sp" android:textColor="#555" android:backgroundTint="#FFE8E0" android:layout_margin="3dp" android:stateListAnimator="@null" />
        </GridLayout>
    </LinearLayout>

    <!-- ====== 外观设置卡片 ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 外观设置"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="桌宠大小"
            android:textColor="#888888"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/size_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="160"
            android:min="80"
            android:progress="120"
            android:thumbTint="#DE886D"
            android:progressTint="#DE886D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="透明度"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/alpha_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="30"
            android:progress="92"
            android:thumbTint="#DE886D"
            android:progressTint="#DE886D" />

        <TextView
            android:id="@+id/settings_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改后点击重载生效"
            android:textColor="#BBBBBB"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ====== 调试状态卡片 ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 调试状态"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/debug_webview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WebView: 等待加载…"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/debug_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前动作: idle"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/debug_js"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="最近JS: —"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
